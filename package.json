{
  "name": "@dt/delivery-sdk",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "description": "Direct browser SDK for validated chunked digital twins, without a query API server",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./runtime/index.js"
    },
    "./viewport.css": {
      "types": "./types/viewport.css.d.ts",
      "default": "./runtime/viewport.css"
    }
  },
  "files": [
    "runtime",
    "types",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.txt",
    "sdk-manifest.json"
  ],
  "dependencies": {
    "@types/three": "0.186.0",
    "@types/react": "19.3.0"
  }
}